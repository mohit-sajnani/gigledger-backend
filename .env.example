# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/gigledger

# Auth (owned by Auth teammate)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI / LLM
OPENAI_API_KEY=your_openai_key_here
# Used by src/services/rag.service.js — tax rule retrieval + estimation prompts
GEMINI_API_KEY=your_gemini_key_here

# Vector DB (owned by RAG teammate)
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX=gigledger-tax-rules

# File storage (Phase 6 bonus)
CLOUDINARY_URL=your_cloudinary_url_here

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:3000
