# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/gigledger

# Temporary fallback owner for transactions until real auth (protect middleware) is wired in.
# Used by seed.js and transaction routes — remove once auth.middleware.js is real.
DEMO_USER_ID=000000000000000000000001

# Auth (owned by Auth teammate)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI / LLM
OPENAI_API_KEY=your_openai_key_here

# Vector DB (owned by RAG teammate)
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX=gigledger-tax-rules

# File storage (Phase 6 bonus)
CLOUDINARY_URL=your_cloudinary_url_here

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:3000
